{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  /* Sprint 14 (temporário): o teste de caracterização da Sprint 16 ainda está
     RED (módulo `src/domain/validacao.ts` só será criado na Sprint 16, S16-02).
     Excluído do `tsc -b` para manter `npm run build` OK (S14-05); o Vitest
     continua executando o arquivo. REMOVER esta linha na Sprint 16. */
  "exclude": ["src/domain/__tests__/validacao.test.ts"],
  "include": ["src"]
}
